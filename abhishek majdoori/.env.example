# =============================================================================
# Handshake Project Watcher — Environment Configuration Template
#
# Copy this file to `.env` and fill in the required values.
# NEVER commit the real `.env` file — it is listed in .gitignore.
# =============================================================================

# ---------------------------------------------------------------------------
# [REQUIRED] Handshake instance URL
#
# The base URL of your organisation's Handshake deployment.
# Example: https://app.joinhandshake.com
# ---------------------------------------------------------------------------
HANDSHAKE_BASE_URL=https://app.joinhandshake.com

# ---------------------------------------------------------------------------
# [OPTIONAL] Path to the AI Projects listing page (appended to base URL)
# Default: /projects
# ---------------------------------------------------------------------------
HANDSHAKE_PROJECTS_PATH=/projects

# ---------------------------------------------------------------------------
# [OPTIONAL] Polling interval — how often to check for new projects
# Unit: seconds. Minimum recommended: 30. Default: 60.
# Be respectful of the server; do not set this below 30.
# ---------------------------------------------------------------------------
POLL_INTERVAL_SECONDS=60

# ---------------------------------------------------------------------------
# [OPTIONAL] How long each Windows toast notification stays on screen
# Unit: seconds. Default: 10.
# ---------------------------------------------------------------------------
NOTIFICATION_DURATION_SECONDS=10

# ---------------------------------------------------------------------------
# [OPTIONAL] Path to the JSON file that persists seen-project IDs
# Relative to the working directory when you launch the app.
# Default: state/seen_projects.json
# ---------------------------------------------------------------------------
STATE_FILE_PATH=state/seen_projects.json

# ---------------------------------------------------------------------------
# [OPTIONAL] Logging configuration
# ---------------------------------------------------------------------------

# Verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Path to the rotating log file (relative to working directory)
LOG_FILE_PATH=logs/watcher.log

# Maximum size of one log file before rotation (bytes). Default: 10 MB.
LOG_MAX_BYTES=10485760

# Number of rotated backup log files to retain. Default: 5.
LOG_BACKUP_COUNT=5

# ---------------------------------------------------------------------------
# [OPTIONAL] Browser settings (Playwright / Chromium)
# ---------------------------------------------------------------------------

# Run the browser in headless mode (true) or visible mode (false).
# Set to false temporarily if you need to log in / solve a CAPTCHA manually.
BROWSER_HEADLESS=true

# Page-load timeout in milliseconds. Default: 30 000 (30 s).
BROWSER_TIMEOUT_MS=30000

# Path to a Playwright storage-state file (JSON) that stores cookies/auth.
# Generate it once with scripts/save_auth.py, then leave it here.
# Leave blank to start a fresh unauthenticated session.
BROWSER_STORAGE_STATE_PATH=
